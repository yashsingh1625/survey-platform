# Rido Research Environment Configuration

# Production Mode ("production" or "development")
RIDO_ENV=development

# Admin Authentication
RIDO_ADMIN_PASSWORD=your_secure_admin_password_here
RIDO_JWT_SECRET=your_32_char_random_jwt_secret_here
RIDO_JWT_EXPIRE_HOURS=8

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=surveydb

# Documentation (Set to 1 to hide /docs in production)
RIDO_HIDE_DOCS=0
